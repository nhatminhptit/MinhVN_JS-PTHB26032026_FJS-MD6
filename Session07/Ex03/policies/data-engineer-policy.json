{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowReadOnlyAnalyticsBucket",
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:GetObject"],
      "Resource": [
        "arn:aws:s3:::shopfast-analytics-data",
        "arn:aws:s3:::shopfast-analytics-data/*"
      ]
    }
  ]
}
