{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowFullDevAccess",
      "Effect": "Allow",
      "Action": ["s3:*", "ec2:*"],
      "Resource": [
        "arn:aws:s3:::shopfast-dev-*",
        "arn:aws:s3:::shopfast-dev-*/*",
        "arn:aws:ec2:*:*:instance/*"
      ],
      "Condition": {
        "StringEquals": { "aws:ResourceTag/Environment": "dev" }
      }
    },
    {
      "Sid": "AllowReadOnlyProdAccess",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:ListBucket", "ec2:Describe*"],
      "Resource": "*"
    },
    {
      "Sid": "DenyWriteProdAccess",
      "Effect": "Deny",
      "Action": [
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:DeleteBucket",
        "ec2:RunInstances",
        "ec2:StopInstances",
        "ec2:TerminateInstances"
      ],
      "Resource": [
        "arn:aws:s3:::shopfast-prod-*",
        "arn:aws:s3:::shopfast-prod-*/*"
      ]
    }
  ]
}
