{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowReadPaymentLogsBeforeExpiration",
      "Effect": "Allow",
      "Action": [
        "logs:DescribeLogStreams",
        "logs:GetLogEvents",
        "logs:FilterLogEvents"
      ],
      "Resource": "arn:aws:logs:ap-southeast-1:123456789012:log-group:/shopfast/payment-service:*",
      "Condition": {
        "DateLessThan": {
          "aws:CurrentTime": "2026-07-29T23:59:59Z"
        }
      }
    }
  ]
}
