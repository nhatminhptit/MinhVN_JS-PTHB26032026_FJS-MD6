{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowAuditLoggingOnly",
      "Effect": "Allow",
      "Action": [
        "cloudtrail:LookupEvents",
        "cloudtrail:GetTrail",
        "cloudtrail:DescribeTrails",
        "logs:DescribeLogGroups",
        "logs:GetLogEvents",
        "iam:GenerateCredentialReport",
        "iam:GetAccountSummary"
      ],
      "Resource": "*"
    }
  ]
}
