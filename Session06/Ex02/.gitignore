# Thư mục phụ thuộc (Bắt buộc bỏ qua, không bao giờ push lên Git)
node_modules/

# Thư mục chứa mã JavaScript sau khi build từ TypeScript
dist/
build/

# Các tệp cấu hình chứa khóa bí mật, biến môi trường
.env
.env.*
!.env.example

# Nhật ký và file log của npm / hệ thống
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Tệp rác của hệ điều hành và IDE
.DS_Store
Thumbs.db
.vscode/*
!.vscode/settings.json
!.vscode/launch.json
.idea/

# Báo cáo kiểm thử và độ bao phủ code
coverage/
.nyc_output/

# Tệp tạm thời
*.tmp
*.temp
